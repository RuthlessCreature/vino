# Public host port mapped from the ECS machine.
PORT=8797

# Public URL returned to iPhone download-ticket calls.
# Use https://your-domain.example after binding a domain and reverse proxy.
VINO_EXTERNAL_BASE_URL=http://127.0.0.1:8797

# Host paths used by docker compose. On ECS, prefer absolute paths.
VINO_DATA_DIR=./data
VINO_MODELS_DIR=../models

# Container paths for generated artifact caches and one-time encrypted downloads.
VINO_ARTIFACT_CACHE_ROOT=/app/data/artifact-cache
VINO_DOWNLOAD_WORK_ROOT=/app/data/download-work
VINO_BACKUP_ROOT=/app/data/backups

# Max JSON request body size. Asset ingest and model uploads still use base64 in this MVP.
VINO_REQUEST_BODY_LIMIT=200mb

# Basic in-memory rate limit. Keep this high enough for internal ops dashboards.
VINO_RATE_LIMIT_ENABLED=true
VINO_RATE_LIMIT_WINDOW_MS=60000
VINO_RATE_LIMIT_MAX=600
VINO_RATE_LIMIT_AUTH_MAX=30

# Maintenance retention. Artifact cache cleanup only runs when explicitly requested.
VINO_TICKET_RETENTION_DAYS=30
VINO_DOWNLOAD_WORK_RETENTION_MINUTES=60
VINO_ARTIFACT_CACHE_RETENTION_DAYS=30

# Session lifetime for Web console and iPhone-compatible API tokens.
VINO_SESSION_TTL_DAYS=7

# Demo seed switch.
# Keep true for local demos. On a public ECS, set false and provide a bootstrap admin password.
VINO_SEED_DEMO_DATA=true
VINO_BOOTSTRAP_ADMIN_EMAIL=admin
VINO_BOOTSTRAP_ADMIN_PASSWORD=

# Set to 1 if the ECS should not scan the mounted models directory at boot.
VINO_SKIP_MODEL_DISCOVERY=0
